generator client {
  provider     = "prisma-client"
  output       = "../src/generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["agent_runtime", "app", "audit", "radius_runtime"]
}

model Tenant {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug            String   @unique @db.VarChar(80)
  name            String   @db.VarChar(160)
  status          String   @default("active") @db.VarChar(24)
  dataRegion      String   @map("data_region") @db.VarChar(32)
  defaultTimezone String   @default("Europe/Madrid") @map("default_timezone") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships               TenantMembership[]
  roles                     TenantRole[]
  organizations             Organization[]
  siteGroups                SiteGroup[]
  accessPolicies            AccessPolicy[]
  portals                   Portal[]
  processingPurposes        ProcessingPurpose[]
  legalDocuments            LegalDocument[]
  identitySpaces            IdentitySpace[]
  blockedEntities           BlockedEntity[]
  idempotencyKeys           IdempotencyKey[]
  outboxEvents              OutboxEvent[]
  exports                   Export[]
  auditLogs                 AuditLog[]
  siteAgentEnrollmentTokens SiteAgentEnrollmentToken[]
  siteAgentIdentities       SiteAgentIdentity[]

  @@map("tenants")
  @@schema("app")
}

model AdminUser {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  emailCiphertext Bytes    @map("email_ciphertext")
  emailKeyVersion String   @map("email_key_version") @db.VarChar(80)
  emailHmac       Bytes    @unique @map("email_hmac")
  status          String   @default("active") @db.VarChar(24)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         TenantMembership[]
  credential          AdminCredential?
  sessions            AdminSession[]
  totpFactors         AdminTotpFactor[]
  webauthnCredentials AdminWebAuthnCredential[]

  @@map("admin_users")
  @@schema("app")
}

model AdminCredential {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.Text
  hashAlgorithm     String    @default("scrypt") @map("hash_algorithm") @db.VarChar(32)
  hashVersion       Int       @default(1) @map("hash_version")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  passwordExpiresAt DateTime? @map("password_expires_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_credentials")
  @@schema("app")
}

model AdminSession {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           Bytes     @unique @map("token_hash")
  authStrength        String    @default("password") @map("auth_strength") @db.VarChar(32)
  mfaVerifiedAt       DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  ipCiphertext        Bytes?    @map("ip_ciphertext")
  ipHmac              Bytes?    @map("ip_hmac")
  userAgentCiphertext Bytes?    @map("user_agent_ciphertext")
  userAgentHmac       Bytes?    @map("user_agent_hmac")
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt       DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason        String?   @map("revoke_reason") @db.VarChar(160)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("admin_sessions")
  @@schema("app")
}

model AdminTotpFactor {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  label              String    @db.VarChar(80)
  secretCiphertext   Bytes     @map("secret_ciphertext")
  keyVersion         String    @map("key_version") @db.VarChar(80)
  recoveryCodeHashes Bytes[]   @default([]) @map("recovery_code_hashes")
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId, revokedAt])
  @@map("admin_totp_factors")
  @@schema("app")
}

model AdminWebAuthnCredential {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  label          String    @db.VarChar(80)
  credentialId   Bytes     @unique @map("credential_id")
  publicKeyCose  Bytes     @map("public_key_cose")
  signCount      BigInt    @default(0) @map("sign_count")
  transports     String[]  @default([])
  aaguid         String?   @db.Uuid
  backupEligible Boolean   @default(false) @map("backup_eligible")
  backupState    Boolean   @default(false) @map("backup_state")
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId, revokedAt])
  @@map("admin_webauthn_credentials")
  @@schema("app")
}

model TenantMembership {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("active") @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        AdminUser        @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments RoleAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId, status])
  @@map("tenant_memberships")
  @@schema("app")
}

model PermissionCatalog {
  code        String   @id @db.VarChar(120)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permission_catalog")
  @@schema("app")
}

model TenantRole {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  code       String   @db.VarChar(80)
  name       String   @db.VarChar(120)
  systemRole Boolean  @default(false) @map("system_role")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("tenant_roles")
  @@schema("app")
}

model RolePermission {
  id             String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code") @db.VarChar(120)

  role       TenantRole        @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission PermissionCatalog @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, roleId, permissionCode])
  @@map("role_permissions")
  @@schema("app")
}

model RoleAssignment {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  membershipId   String    @map("membership_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  scopeType      String    @map("scope_type") @db.VarChar(24)
  organizationId String?   @map("organization_id") @db.Uuid
  siteGroupId    String?   @map("site_group_id") @db.Uuid
  siteId         String?   @map("site_id") @db.Uuid
  startsAt       DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  membership   TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role         TenantRole       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  organization Organization?    @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)
  siteGroup    SiteGroup?       @relation(fields: [tenantId, siteGroupId], references: [tenantId, id], onDelete: Restrict)
  site         Site?            @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, membershipId, expiresAt])
  @@map("role_assignments")
  @@schema("app")
}

model Organization {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  code       String    @db.VarChar(64)
  name       String    @db.VarChar(160)
  legalName  String?   @map("legal_name") @db.VarChar(200)
  status     String    @default("active") @db.VarChar(24)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sites             Site[]
  siteGroups        SiteGroup[]
  roleAssignments   RoleAssignment[]
  policyAssignments PolicyAssignment[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("organizations")
  @@schema("app")
}

model SiteGroup {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  name           String    @db.VarChar(160)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  organization      Organization?      @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)
  memberships       SiteGroupSite[]
  configParentSites Site[]             @relation("SiteConfigParent")
  roleAssignments   RoleAssignment[]
  policyAssignments PolicyAssignment[]

  @@unique([tenantId, id])
  @@index([tenantId, organizationId])
  @@map("site_groups")
  @@schema("app")
}

model Site {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  configParentGroupId String?   @map("config_parent_group_id") @db.Uuid
  code                String    @db.VarChar(64)
  name                String    @db.VarChar(160)
  status              String    @default("active") @db.VarChar(24)
  timezone            String    @db.VarChar(64)
  countryCode         String    @map("country_code") @db.Char(2)
  languages           String[]  @default(["es"])
  branding            Json      @default("{}") @db.JsonB
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization              Organization               @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: Restrict)
  configParentGroup         SiteGroup?                 @relation("SiteConfigParent", fields: [tenantId, configParentGroupId], references: [tenantId, id], onDelete: Restrict)
  groupMemberships          SiteGroupSite[]
  zones                     Zone[]
  gateways                  Gateway[]
  roleAssignments           RoleAssignment[]
  policyAssignments         PolicyAssignment[]
  loginMethods              LoginMethod[]
  portalPublications        PortalPublication[]
  voucherBatches            VoucherBatch[]
  authorizedDevices         AuthorizedDevice[]
  siteAgentEnrollmentTokens SiteAgentEnrollmentToken[]

  @@unique([tenantId, id])
  @@index([tenantId, organizationId, status])
  @@map("sites")
  @@schema("app")
}

model SiteGroupSite {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  siteGroupId String   @map("site_group_id") @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  siteGroup SiteGroup @relation(fields: [tenantId, siteGroupId], references: [tenantId, id], onDelete: Cascade)
  site      Site      @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, siteGroupId, siteId])
  @@map("site_group_sites")
  @@schema("app")
}

model Zone {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  siteId     String    @map("site_id") @db.Uuid
  name       String    @db.VarChar(120)
  kind       String    @db.VarChar(32)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  site               Site                 @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)
  ssids              Ssid[]
  gatewayBindings    GatewayZoneBinding[]
  policyAssignments  PolicyAssignment[]
  portalPublications PortalPublication[]

  @@unique([tenantId, id])
  @@index([tenantId, siteId])
  @@map("zones")
  @@schema("app")
}

model Ssid {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  zoneId       String    @map("zone_id") @db.Uuid
  name         String    @db.VarChar(64)
  instructions Json      @default("{}") @db.JsonB
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  zone Zone @relation(fields: [tenantId, zoneId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, zoneId])
  @@map("ssids")
  @@schema("app")
}

model Gateway {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  siteId          String    @map("site_id") @db.Uuid
  name            String    @db.VarChar(120)
  model           String?   @db.VarChar(100)
  serial          String?   @db.VarChar(100)
  routerOsVersion String?   @map("routeros_version") @db.VarChar(40)
  architecture    String?   @db.VarChar(40)
  nasIdentifier   String    @unique @map("nas_identifier") @db.VarChar(128)
  status          String    @default("pending") @db.VarChar(24)
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz(6)
  retiredAt       DateTime? @map("retired_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  site                      Site                       @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)
  zoneBindings              GatewayZoneBinding[]
  secretVersions            GatewaySecretVersion[]
  configRevisions           GatewayConfigRevision[]
  captiveAttempts           CaptiveAttempt[]
  accessAuthorizations      AccessAuthorization[]
  radiusSessions            RadiusSession[]
  radiusCredentials         RadiusRuntimeCredential[]
  nasRegistry               RadiusNasRegistry?
  accountingInbox           RadiusAccountingInbox[]
  postAuthInbox             RadiusPostAuthInbox[]
  captiveLocators           GatewayCaptiveLocator[]
  siteAgentEnrollmentTokens SiteAgentEnrollmentToken[]
  siteAgentIdentities       SiteAgentIdentity[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, siteId])
  @@index([tenantId, siteId, status, lastSeenAt])
  @@map("gateways")
  @@schema("app")
}

model GatewayCaptiveLocator {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  gatewayId           String    @map("gateway_id") @db.Uuid
  locatorHash         Bytes     @unique @map("locator_hash")
  allowedLoginOrigins String[]  @default([]) @map("allowed_login_origins")
  replacesLocatorId   String?   @map("replaces_locator_id") @db.Uuid
  notBefore           DateTime  @default(now()) @map("not_before") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  gateway    Gateway                 @relation(fields: [tenantId, gatewayId], references: [tenantId, id], onDelete: Restrict)
  replaces   GatewayCaptiveLocator?  @relation("GatewayCaptiveLocatorRotation", fields: [tenantId, replacesLocatorId], references: [tenantId, id], onDelete: Restrict)
  replacedBy GatewayCaptiveLocator[] @relation("GatewayCaptiveLocatorRotation")

  @@unique([tenantId, id])
  @@index([tenantId, gatewayId, expiresAt])
  @@map("gateway_captive_locators")
  @@schema("app")
}

model SiteAgentEnrollmentToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  siteId     String    @map("site_id") @db.Uuid
  gatewayId  String    @map("gateway_id") @db.Uuid
  identityId String    @unique @default(dbgenerated("uuidv7()")) @map("identity_id") @db.Uuid
  tokenHash  Bytes     @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site     Site               @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)
  gateway  Gateway            @relation(fields: [tenantId, gatewayId, siteId], references: [tenantId, id, siteId], onDelete: Restrict)
  identity SiteAgentIdentity?

  @@unique([tenantId, id])
  @@unique([tenantId, id, siteId, gatewayId, identityId])
  @@index([tenantId, gatewayId, expiresAt])
  @@index([expiresAt, consumedAt, revokedAt])
  @@map("site_agent_enrollment_tokens")
  @@schema("agent_runtime")
}

model SiteAgentIdentity {
  id                        String    @id @db.Uuid
  tenantId                  String    @map("tenant_id") @db.Uuid
  siteId                    String    @map("site_id") @db.Uuid
  gatewayId                 String    @map("gateway_id") @db.Uuid
  enrollmentTokenId         String    @unique @map("enrollment_token_id") @db.Uuid
  protocolVersion           Int       @map("protocol_version") @db.SmallInt
  agentVersion              String    @map("agent_version") @db.VarChar(64)
  hostname                  String    @db.VarChar(253)
  publicKeySpki             Bytes     @map("public_key_spki")
  publicKeySha256           Bytes     @unique @map("public_key_sha256")
  enrollmentNonceHash       Bytes     @unique @map("enrollment_nonce_hash")
  capabilities              String[]
  status                    String    @default("active") @db.VarChar(24)
  certificatePem            String    @map("certificate_pem") @db.Text
  certificateSerial         String    @unique @map("certificate_serial") @db.VarChar(160)
  certificateFingerprintSha Bytes     @unique @map("certificate_fingerprint_sha256")
  certificateNotBefore      DateTime  @map("certificate_not_before") @db.Timestamptz(6)
  certificateNotAfter       DateTime  @map("certificate_not_after") @db.Timestamptz(6)
  lastIssuedCommandSequence BigInt    @default(0) @map("last_issued_command_sequence")
  lastSeenAt                DateTime? @map("last_seen_at") @db.Timestamptz(6)
  lastHeartbeatAt           DateTime? @map("last_heartbeat_at") @db.Timestamptz(6)
  revokedAt                 DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason              String?   @map("revoke_reason") @db.VarChar(300)
  enrolledAt                DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  gateway         Gateway                  @relation(fields: [tenantId, gatewayId, siteId], references: [tenantId, id, siteId], onDelete: Restrict)
  enrollmentToken SiteAgentEnrollmentToken @relation(fields: [tenantId, enrollmentTokenId, siteId, gatewayId, id], references: [tenantId, id, siteId, gatewayId, identityId], onDelete: Restrict)
  commands        SiteAgentCommand[]
  events          SiteAgentEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, siteId, gatewayId])
  @@unique([tenantId, enrollmentTokenId, siteId, gatewayId, id])
  @@index([tenantId, gatewayId, status])
  @@index([status, certificateNotAfter])
  @@map("site_agent_identities")
  @@schema("agent_runtime")
}

model SiteAgentCommand {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  siteId          String    @map("site_id") @db.Uuid
  gatewayId       String    @map("gateway_id") @db.Uuid
  identityId      String    @map("identity_id") @db.Uuid
  protocolVersion Int       @map("protocol_version") @db.SmallInt
  sequence        BigInt
  type            String    @db.VarChar(80)
  payload         Json      @db.JsonB
  issuedAt        DateTime  @map("issued_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  signature       String    @db.VarChar(688)
  commandDigest   String    @map("command_digest") @db.Char(64)
