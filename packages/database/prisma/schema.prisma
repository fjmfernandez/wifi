  reason       String    @db.VarChar(300)
  scope        Json      @db.JsonB
  containsPii  Boolean   @default(false) @map("contains_pii")
  objectKey    String?   @map("object_key") @db.VarChar(600)
  objectHash   String?   @map("object_hash") @db.Char(64)
  state        String    @default("requested") @db.VarChar(24)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  downloadedAt DateTime? @map("downloaded_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dsr    DataSubjectRequest? @relation(fields: [tenantId, dsrId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, state, expiresAt])
  @@map("exports")
  @@schema("app")
}

model AuditLog {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  actorType      String   @map("actor_type") @db.VarChar(24)
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(120)
  resourceType   String   @map("resource_type") @db.VarChar(80)
  resourceId     String?  @map("resource_id") @db.Uuid
  scope          Json     @default("{}") @db.JsonB
  beforeRedacted Json?    @map("before_redacted") @db.JsonB
  afterRedacted  Json?    @map("after_redacted") @db.JsonB
  sourceIpHmac   Bytes?   @map("source_ip_hmac")
  correlationId  String   @map("correlation_id") @db.Uuid
  reason         String?  @db.VarChar(300)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  previousHash   String?  @map("previous_hash") @db.Char(64)
  rowHash        String   @default(dbgenerated("repeat('0'::text, 64)")) @map("row_hash") @db.Char(64)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, occurredAt])
  @@index([tenantId, actorId, occurredAt])
  @@index([tenantId, resourceType, resourceId, occurredAt])
  @@map("audit_logs")
  @@schema("audit")
}
