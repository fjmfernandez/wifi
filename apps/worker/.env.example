NODE_ENV=development
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=3003
LOG_LEVEL=info
BUILD_SHA=development

# Login wifi_jobs; bootstrap/migration credentials must never reach this service.
DATABASE_URL=postgresql://wifi_jobs:change-me@localhost:5432/wifi_entelsat
WORKER_DATABASE_CONNECTION_LIMIT=10
WORKER_DATABASE_CONNECTION_TIMEOUT_MS=5000
WORKER_DATABASE_IDLE_TIMEOUT_MS=30000

# Never commit the real password. Use rediss:// when Redis is outside the private network.
REDIS_URL=redis://:change-me@localhost:6379/0
REDIS_QUEUE_PREFIX=wifi
REDIS_CONNECT_TIMEOUT_MS=5000

# Outbox requires a real publisher; exports/retention require storage/approval handlers.
WORKER_REQUIRED_QUEUES=accounting
WORKER_CLAIM_INTERVAL_MS=1000
WORKER_CLAIM_BATCH_SIZE=32
WORKER_DATABASE_LEASE_SECONDS=300
WORKER_POLLER_STALE_AFTER_MS=10000
WORKER_OUTBOX_CONCURRENCY=8
WORKER_ACCOUNTING_CONCURRENCY=16
WORKER_EXPORTS_CONCURRENCY=2
WORKER_RETENTION_CONCURRENCY=1
WORKER_ATTEMPTS=8
WORKER_BACKOFF_MS=1000
WORKER_LOCK_DURATION_MS=120000
WORKER_PROCESSING_TIMEOUT_MS=90000
WORKER_IDEMPOTENCY_LOCK_TTL_MS=180000
WORKER_IDEMPOTENCY_RESULT_TTL_SECONDS=604800
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_HEALTH_TIMEOUT_MS=1500
WORKER_REMOVE_COMPLETE_AGE_SECONDS=86400
WORKER_REMOVE_COMPLETE_COUNT=10000
WORKER_REMOVE_FAILED_AGE_SECONDS=604800
WORKER_REMOVE_FAILED_COUNT=50000
