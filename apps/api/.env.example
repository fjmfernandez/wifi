NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgresql://wifi_api:change-me@127.0.0.1:5432/wifi_entelsat
DATABASE_POOL_SIZE=10
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
TRUST_PROXY=false
SWAGGER_ENABLED=true
BUILD_SHA=development
DEMO_MODE=false
CAPTIVE_PUBLIC_ORIGIN=http://localhost:3002
CAPTIVE_STATE_HMAC_KEY_BASE64=replace-with-32-random-bytes-as-base64url
CAPTIVE_IDENTIFIER_HMAC_KEY_BASE64=replace-with-a-different-base64url-key
ADMIN_PUBLIC_ORIGIN=http://localhost:3000
ADMIN_EMAIL_HMAC_KEY_BASE64=replace-with-a-different-base64url-key
ADMIN_SESSION_HMAC_KEY_BASE64=replace-with-a-different-base64url-key
DATA_ENCRYPTION_MASTER_KEY_BASE64=replace-with-a-different-base64url-key
DATA_ENCRYPTION_KEY_VERSION=env-v1
VOUCHER_HMAC_MASTER_KEY_BASE64=replace-with-a-different-base64url-key
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_HOURS=8
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# blocked | cleartext-lab-validated
RADIUS_CREDENTIAL_MODE=blocked

# Plano del agente de sede. Ambos modos arrancan deshabilitados: mientras lo estén,
# /site-agent responde 503 en vez de aceptar agentes sin autenticar.
# disabled | shared-secret
SITE_AGENT_MTLS_PROXY_MODE=disabled
SITE_AGENT_MTLS_PROXY_SHARED_SECRET_BASE64=
# disabled | ed25519
SITE_AGENT_COMMAND_SIGNING_MODE=disabled
# Clave privada Ed25519 en DER/PKCS8, base64 estándar. Su pública se fija en el agente
# mediante SITE_AGENT_COMMAND_SIGNING_PUBLIC_KEY_BASE64.
SITE_AGENT_COMMAND_SIGNING_PRIVATE_KEY_BASE64=
SITE_AGENT_ENROLLMENT_TOKEN_HMAC_KEY_BASE64=replace-with-a-different-base64url-key
SITE_AGENT_CERTIFICATE_TTL_HOURS=720
SITE_AGENT_MAX_COMMANDS_PER_LEASE=10
SITE_AGENT_COMMAND_LEASE_SECONDS=300
SITE_AGENT_COMMAND_MAX_TTL_SECONDS=600
SITE_AGENT_EVENT_MAX_AGE_DAYS=7
