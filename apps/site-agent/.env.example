# Never commit real enrollment tokens, storage keys, certificates or RouterOS credentials.
NODE_ENV=development
SITE_AGENT_CLOUD_URL=https://wifi.entelsat.com
SITE_AGENT_CAPTIVE_ORIGIN=https://captive.wifi.entelsat.com
SITE_AGENT_DB_PATH=./data/site-agent.sqlite

# Exactly 32 random bytes, base64 encoded. Example generator:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
SITE_AGENT_STORAGE_KEY_BASE64=REPLACE_WITH_32_RANDOM_BYTES_BASE64

# Pinned Ed25519 command-signing public key in DER/SPKI, base64 encoded.
SITE_AGENT_COMMAND_SIGNING_PUBLIC_KEY_BASE64=REPLACE_WITH_ED25519_SPKI_DER_BASE64

# Supply only for the first boot. It is never persisted and the cloud contract must consume it once.
SITE_AGENT_ENROLLMENT_TOKEN=

SITE_AGENT_HEALTH_HOST=127.0.0.1
SITE_AGENT_HEALTH_PORT=3004
SITE_AGENT_POLL_INTERVAL_MS=5000
SITE_AGENT_HEARTBEAT_INTERVAL_MS=30000
SITE_AGENT_CLOUD_TIMEOUT_MS=8000
SITE_AGENT_SHUTDOWN_TIMEOUT_MS=15000
SITE_AGENT_MAX_COMMANDS_PER_POLL=10
SITE_AGENT_COMMAND_CLOCK_SKEW_MS=30000
SITE_AGENT_COMMAND_MAX_TTL_MS=600000
SITE_AGENT_READINESS_MAX_CLOUD_STALENESS_MS=120000
SITE_AGENT_BACKOFF_BASE_MS=1000
SITE_AGENT_BACKOFF_MAX_MS=60000
LOG_LEVEL=info
BUILD_SHA=development
