# Host-only UDP bindings for the disposable compose lab.
RADIUS_A_AUTH_PORT=1812
RADIUS_A_ACCT_PORT=1813
RADIUS_B_AUTH_PORT=2812
RADIUS_B_ACCT_PORT=2813

# RouterOS /radius/incoming uses 1700 by default. Set 3799 only when the
# router, firewall and sender are all changed together.
RADIUS_COA_PORT=1700
