FROM node:24.15.0-bookworm-slim AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/worker/package.json apps/worker/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
RUN pnpm install --frozen-lockfile --filter @wifi/worker...

FROM dependencies AS builder
COPY . .
RUN pnpm --filter @wifi/contracts build \
    && pnpm --filter @wifi-entelsat/database build \
    && pnpm --filter @wifi/worker build
# See Dockerfile.api: pnpm's isolated layout keeps each workspace package's dependencies in
# its own node_modules, so the runtime stage must copy those too, and the directories have to
# exist even when a package has none. The dependencies stage stays the only install; pruning
# again here does not shrink the image, it only slows the build.
RUN mkdir -p apps/worker/node_modules \
       packages/contracts/node_modules \
       packages/database/node_modules

FROM node:24.15.0-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV WORKER_HEALTH_HOST=0.0.0.0
ENV WORKER_HEALTH_PORT=3003
WORKDIR /workspace
COPY --from=builder --chown=node:node /workspace/node_modules ./node_modules
COPY --from=builder --chown=node:node /workspace/apps/worker/package.json ./apps/worker/package.json
COPY --from=builder --chown=node:node /workspace/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=builder --chown=node:node /workspace/apps/worker/dist ./apps/worker/dist
COPY --from=builder --chown=node:node /workspace/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=builder --chown=node:node /workspace/packages/contracts/node_modules ./packages/contracts/node_modules
COPY --from=builder --chown=node:node /workspace/packages/contracts/dist ./packages/contracts/dist
COPY --from=builder --chown=node:node /workspace/packages/database/package.json ./packages/database/package.json
COPY --from=builder --chown=node:node /workspace/packages/database/node_modules ./packages/database/node_modules
COPY --from=builder --chown=node:node /workspace/packages/database/dist ./packages/database/dist
USER node
EXPOSE 3003
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:3003/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "apps/worker/dist/main.js"]
