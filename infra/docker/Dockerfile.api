FROM node:24.15.0-bookworm-slim AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/radius/package.json packages/radius/package.json
COPY packages/security/package.json packages/security/package.json
RUN pnpm install --frozen-lockfile --filter @wifi/api...

FROM dependencies AS builder
COPY . .
RUN pnpm --filter @wifi/contracts build \
    && pnpm --filter @wifi/security build \
    && pnpm --filter @wifi/radius build \
    && pnpm --filter @wifi-entelsat/database build \
    && pnpm --filter @wifi/api build

FROM node:24.15.0-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0
WORKDIR /workspace
COPY --from=builder --chown=node:node /workspace/node_modules ./node_modules
COPY --from=builder --chown=node:node /workspace/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=node:node /workspace/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=node:node /workspace/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=builder --chown=node:node /workspace/packages/contracts/dist ./packages/contracts/dist
COPY --from=builder --chown=node:node /workspace/packages/database/package.json ./packages/database/package.json
COPY --from=builder --chown=node:node /workspace/packages/database/dist ./packages/database/dist
COPY --from=builder --chown=node:node /workspace/packages/radius/package.json ./packages/radius/package.json
COPY --from=builder --chown=node:node /workspace/packages/radius/dist ./packages/radius/dist
COPY --from=builder --chown=node:node /workspace/packages/security/package.json ./packages/security/package.json
COPY --from=builder --chown=node:node /workspace/packages/security/dist ./packages/security/dist
USER node
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:3001/api/v1/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "apps/api/dist/main.js"]
